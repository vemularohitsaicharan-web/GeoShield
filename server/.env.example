GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
PORT=8787

# Used only by scripts/seed.mjs (run manually from a terminal), never by
# the mobile app or the Groq proxy itself. The service-role key bypasses
# Row Level Security — never put it in mobile/.env.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Used only by scripts/create-demo-user.mjs to create the 5 role login
# accounts (see mobile/lib/demoAccounts.ts, which must use the same value).
DEMO_PASSWORD=choose_a_password
